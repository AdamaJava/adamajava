# gradle project .gitignore from https://github.com/github/gitignore/blob/master/Gradle.gitignore
.gradle
/build/
/*/build/
/*/adama/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Cache of project
.gradletasknamecache

# # Work around https://youtrack.jetbrains.com/issue/IDEA-116898
# gradle/wrapper/gradle-wrapper.properties

# Files written into the module folder by unit tests
/qannotate/output.log*
/qbamfix/Test.tmp.bam.bai
/qbammerge/copied_file.sam
/qbammerge/logfile
/qmule/logfile
/qmule/output.bam.log*
