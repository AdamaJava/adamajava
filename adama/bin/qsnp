#!/bin/bash

if [ -z "$ADAMA_HOME" ]; then
    echo "qsnp: The ADAMA_HOME environment variable must be set."
    exit 1
fi

# Parallel GC: ~11% faster than the default G1 and half the CPU on a WGS pair (identical output)
java -XX:+UseParallelGC -jar ${ADAMA_HOME}/build/lib/qsnp.jar "$@"
#java -jar ${ADAMA_HOME}/build/lib/qsnp-0.1pre.jar "$@"
